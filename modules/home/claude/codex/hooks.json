{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '@HOME@/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sh '@HOME@/.codex/codex-title.sh'",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  }
}
